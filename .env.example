# Server Port
PORT=3001

# Plaid API Credentials (Get free keys from dashboard.plaid.com)
# Plaid Environment: 'sandbox', 'development', or 'production'
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here

# Set to true to use built-in mock bank data without Plaid keys
USE_MOCK_DATA=true
